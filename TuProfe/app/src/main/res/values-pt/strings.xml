    <!-- Ajuda e suporte -->
    <string name="faq">Perguntas frequentes</string>
    <string name="faq_q1">Como funciona o TuProfe?</string>
    <string name="faq_a1">O TuProfe é uma plataforma onde estudantes podem avaliar e deixar opiniões sobre seus professores, ajudando a comunidade a escolher melhor as suas disciplinas.</string>
    <string name="faq_q2">Como deixar uma avaliação?</string>
    <string name="faq_a2">Pesquise o professor no buscador, acesse o perfil dele e toque em "Avaliar". Preencha o formulário e publique sua avaliação.</string>
    <string name="faq_q3">Posso editar ou excluir minha avaliação?</string>
    <string name="faq_a3">Sim. No histórico de avaliações, você pode editar ou excluir suas avaliações publicadas a qualquer momento.</string>
    <string name="faq_q4">Minhas avaliações são anônimas?</string>
    <string name="faq_a4">As avaliações estão vinculadas à sua conta. Outros usuários podem ver seu nome de usuário, portanto não são completamente anônimas.</string>
    <string name="terminos_y_condiciones">Termos e condições</string>
    <string name="terminos_desc">Ao usar o TuProfe, você concorda com nossos termos de uso e política de privacidade.</string>
