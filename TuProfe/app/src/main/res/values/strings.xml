    <!-- Ayuda y Soporte -->
    <string name="faq">Preguntas frecuentes</string>
    <string name="faq_q1">¿Cómo funciona TuProfe?</string>
    <string name="faq_a1">TuProfe es una plataforma donde los estudiantes pueden calificar y dejar reseñas sobre sus profesores, ayudando a la comunidad a elegir mejor sus cursos.</string>
    <string name="faq_q2">¿Cómo dejo una reseña?</string>
    <string name="faq_a2">Busca al profesor en el buscador, entra a su perfil y toca el botón "Calificar". Completa el formulario y publica tu reseña.</string>
    <string name="faq_q3">¿Puedo editar o eliminar mi reseña?</string>
    <string name="faq_a3">Sí. Desde el historial de calificaciones puedes editar o eliminar tus reseñas publicadas en cualquier momento.</string>
    <string name="faq_q4">¿Mis reseñas son anónimas?</string>
    <string name="faq_a4">Las reseñas están asociadas a tu cuenta. Otros usuarios pueden ver tu nombre de usuario, por lo que no son completamente anónimas.</string>
