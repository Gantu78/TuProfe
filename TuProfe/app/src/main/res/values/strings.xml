    <!-- Help and Support -->
    <string name="faq">Frequently Asked Questions</string>
    <string name="faq_q1">How does TuProfe work?</string>
    <string name="faq_a1">TuProfe is a platform where students can rate and leave reviews about their professors, helping the community choose their courses better.</string>
    <string name="faq_q2">How do I leave a review?</string>
    <string name="faq_a2">Search for the professor in the search engine, go to their profile and tap the \"Rate\" button. Complete the form and publish your review.</string>
    <string name="faq_q3">Can I edit or delete my review?</string>
    <string name="faq_a3">Yes. From the rating history you can edit or delete your published reviews at any time.</string>
    <string name="faq_q4">Are my reviews anonymous?</string>
    <string name="faq_a4">Reviews are associated with your account. Other users can see your username, so they are not completely anonymous.</string>
